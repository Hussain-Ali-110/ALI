# ─────────────────────────────────────────
# Tahir Ali Orakzai — Portfolio .env.local
# ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Email (Nodemailer — Gmail app password)
# Enable 2FA on Gmail → App Passwords → generate one
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_here

# Site URL (for Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://tahirali.dev

# Optional: EmailJS (client-side alternative)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
